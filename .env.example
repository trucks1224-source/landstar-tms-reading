# Copy to .env for local development. Never put real values in this file.

# Browser-visible (safe to expose; protected by Supabase login + row-level security)
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# Server-only (local .env and Vercel project settings; never prefix with VITE_)
GOOGLE_MAPS_API_KEY=
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://YOUR-APP.vercel.app/api/gmail-connect
CRON_SECRET=a-long-random-string

# DAT Ratecast / RateView (server-only; from your DAT integration email)
DAT_USERNAME=your-dat-service-account-email
DAT_PASSWORD=your-dat-service-account-password
DAT_USER_USERNAME=your-dat-end-user-email
# Optional overrides (staging: DAT_AUTH_BASE=https://api.staging.dat.com)
# DAT_AUTH_BASE=https://api.dat.com
# DAT_RATECAST_URL=https://analytics.api.dat.com/ratecast/v1/rates
