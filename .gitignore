bot/browser-profile-removal/
bot/browser-profile-rates/
# Upload bot: live queues, results and status (change every few seconds)
bot/*-queue.json
bot/unpost-queue.backup-*.json
bot/bot-results.json
bot/helper-status.json
bot/removal-status.json
bot/rates-status.json
bot/rates-status.json.*.tmp
bot/watchdog-status.json
bot/watchdog-status.json.*.tmp
