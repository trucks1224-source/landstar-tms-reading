bot/assign-queue.json.lock
bot/assign-queue.json.attempts/
bot/tracking-watch.json
bot/tracking-bills.json
bot/duplicate-bills.json
bot/posting-maintenance.json
bot/local-bot-control.json
bot/local-bot-control.json.*.tmp
bot/posting-maintenance.json.*.tmp
bot/posting-refresh-state.json
bot/posting-refresh-state.json.*.tmp
bot/refresh-exports/
# Customer rate confirmations, MercuryGate screenshots, OCR cache, debugging leftovers
bot/ratecons/
bot/mercurygate-shots/
bot/.tesseract-cache/
bot/debug*
bot/prechecked.json

.claude/settings.local.json
# This computer's own Landstar posting code (each teammate has their own)
bot/agent-config.json
teammate-setup/out/
